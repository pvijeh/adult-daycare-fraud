# Postgres URL shared by the Vercel app and refresh workflow.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional; raises NYC Open Data API limits.
SOCRATA_APP_TOKEN=

# Optional; the pipeline falls back to the official ACS bulk file without it.
CENSUS_API_KEY=

# Optional; forces deterministic NPPES fixtures in local pipeline runs.
USE_MOCK_NPPES=false
